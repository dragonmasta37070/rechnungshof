# Builds the Angular app and serves it with nginx.
#
# The build context is the repository root, not apps/frontend: the app imports
# @abrechnung/core, /types and /utils straight from their TypeScript sources via
# tsconfig path aliases, so the whole pnpm workspace has to be present or the
# compile fails on unresolved imports.

FROM docker.io/node:24-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /src

# Manifests first so the dependency layer is cached independently of source
# changes — editing a component should not re-run a full install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
COPY apps/web/package.json apps/web/
COPY libs/api/package.json libs/api/
COPY libs/components/package.json libs/components/
COPY libs/core/package.json libs/core/
COPY libs/redux/package.json libs/redux/
COPY libs/translations/package.json libs/translations/
COPY libs/types/package.json libs/types/
COPY libs/utils/package.json libs/utils/
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY libs/ libs/
COPY apps/frontend/ apps/frontend/
RUN pnpm --filter frontend exec ng build

FROM docker.io/nginx:stable-alpine
COPY --from=build /src/apps/frontend/dist/frontend/browser/ /var/www/rechnungshof/
COPY docker/nginx-angular /etc/nginx/conf.d/default.conf
