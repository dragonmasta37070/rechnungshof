ABRECHNUNG_SERVICE__NAME=Rechnungshof

ABRECHNUNG_DATABASE__HOST=rechnungshof_postgres
ABRECHNUNG_DATABASE__USER=abrechnung
ABRECHNUNG_DATABASE__DBNAME=abrechnung
ABRECHNUNG_DATABASE__PASSWORD=replaceme # e.g. pwgen -s 64 1

ABRECHNUNG_API__SECRET_KEY=replaceme # pwgen -s 64 1
ABRECHNUNG_API__BASE_URL=http://localhost:9980
ABRECHNUNG_API__PORT=8080
ABRECHNUNG_API__ID=default

#

# ── Authentik / OIDC ──────────────────────────────────────────────────────────
# The backend is a pure resource server: it validates access tokens and never
# performs an OAuth handshake itself. Clients run the authorization code flow
# with PKCE against Authentik and send the resulting token as a bearer token.
#
# ISSUER must match the "iss" claim in the token exactly, trailing slash included.
# AUDIENCE is the client id of the Authentik provider.
# JWKS_URL is where the public signing keys are published.
ABRECHNUNG_OIDC__ISSUER=https://authentik.example.org/application/o/rechnungshof/
ABRECHNUNG_OIDC__AUDIENCE=replaceme-client-id
ABRECHNUNG_OIDC__JWKS_URL=https://authentik.example.org/application/o/rechnungshof/jwks/

POSTGRES_USER=abrechnung
POSTGRES_PASSWORD=replaceme # use the same as DB_PASSWORD
POSTGRES_DB=abrechnung # use the same as DB_NAME
